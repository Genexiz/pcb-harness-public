  "errata": {
    "source_id": "stm32-errata",
    "source_sha256": null,
    "locator": "ES096 Rev15 web inspection2026-10-10; original file unavailable",
    "device_marking": null,
    "rev_id": null,
    "items": [
      {
        "id": "2.2.8",
        "policy": "Avoid WFE USB/PVD wakeup; verify interrupt handling before low-power modes."
      },
      {
        "id": "2.2.9",
        "policy": "Record physical marking and REV_ID;0x2003 aliases multiple markings; audit early-revision compiler workaround."
      },
      {
        "id": "2.3.7",
        "policy": "Keep default SPI1 PA5/6/7 mapping while I2C1 is clocked."
      },
      {
        "id": "2.3.10",
        "policy": "Keep TIM1_CH2 PWM inactive; audit remap before enabling alongside USART1."
      },
      {
        "id": "2.4.1",
        "policy": "Clear specific UART DMA HT/TC/TE flags; never clear global GIF on an active channel."
      },
      {
        "id": "2.4.2",
        "policy": "Use aligned32-bit DMA register access."
      },
      {
        "id": "2.8.1",
        "policy": "Highest application I2C IRQ priority; bound latency and test N=1/2/>2 receive sequences."
      },
      {
        "id": "2.8.2",
        "policy": "Implement a documented last-byte/STOP workaround; verify final bytes under worst IRQ load."
      },
      {
        "id": "2.8.4",
        "policy": "Bound START-to-SB wait and BERR handling; recover through source-correct timed reset."
      },
      {
        "id": "2.8.5",
        "policy": "Preserve100kHz target; qualify repeated-start rise time/slave stretching. Issue design revision if source conditions cannot be met."
      },
      {
        "id": "2.8.7",
        "policy": "Implement GPIO open-drain analog-filter unlock with bounded line readback and SWRST; distinguish an externally held bus."
      },
      {
        "id": "2.9.2",
        "policy": "Do not rely on UART IDLE alone for framing; periodic/HT/TC circular DMA service plus CRC/sequence counters."
      },
      {
        "id": "2.10.2",
        "policy": "Disable SPI hardware CRC when UART DMA shares request channels; use application/software CRC."
      },
      {
        "id": "2.12.1",
        "policy": "Audit suspend/FRES false-wakeup recovery per ES096."
      },
      {
        "id": "2.12.2",
        "policy": "Disable remote wakeup initially; if enabled mask SUSP for3ms after signaling resume."
      },
      {
        "id": "2.12.3",
        "policy": "Use USB hardware CRC validity; ignore wrong CRC16 bytes in PMA."
      },
      {
        "id": "2.12.4",
        "policy": "Maintain APB1 at36MHz during active USB; RCC readback/packet-count tests."
      }
    ]
  }
}
