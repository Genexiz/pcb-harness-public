{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Z]+[0-9]+$"
          },
          "part_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "block": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "schematic_position_mm": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "bootstrap_position_mm": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "ref",
          "part_id",
          "value",
          "block",
          "fact_ids",
          "schematic_position_mm",
          "bootstrap_position_mm"
        ],
        "additionalProperties": false
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "net_class": {
            "type": "string",
            "minLength": 1
          },
          "voltage_range_v": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instance_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
                },
                "pin_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
                }
              },
              "required": [
                "instance_id",
                "pin_id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "net_class",
          "voltage_range_v",
          "endpoints"
        ],
        "additionalProperties": false
      }
    },
    "no_connect": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "pin_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "fact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          }
        },
        "required": [
          "instance_id",
          "pin_id",
          "reason",
          "fact_id"
        ],
        "additionalProperties": false
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "instance_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "peripheral": {
            "type": "string",
            "minLength": 1
          },
          "pin_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "instance_id",
          "peripheral",
          "pin_ids"
        ],
        "additionalProperties": false
      }
    },
    "errata_mitigations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "fact_id",
          "description",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "instances",
    "nets",
    "no_connect",
    "interfaces",
    "errata_mitigations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
